<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AND.40 unit 3: the .NET MAUI Android application (net10.0-android only). It hosts the Hello screen over the
    Hello transport (src/core/ArcForges.Mobile.Network) and shows the embedded build identity. The Keystore probe
    is not referenced: it is a test-only device harness (AND.40 decision 11).
    Machine-specific SDK and JDK locations are never committed: JAVA_HOME and ANDROID_HOME come from the
    environment. Signing is not configured here: the persistent release key signs the candidate in the protected
    release job, outside the build (AGENTS.md; docs/releasing.md). See docs/maui-toolchain.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <RootNamespace>ArcForges.Mobile</RootNamespace>
    <AssemblyName>ArcForges.Mobile</AssemblyName>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LicenceBoundary>Apache</LicenceBoundary>

    <!-- Permanent Android application identity (IRD-23, P2-021 item 3). -->
    <ApplicationId>com.arcforges.mobile</ApplicationId>
    <ApplicationTitle>ArcForges</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <!-- Android versionCode: monotonic packaging value, supplied by the release pipeline (AND.40). -->
    <ApplicationVersion Condition="'$(ArcForgesAndroidVersionCode)' != ''">$(ArcForgesAndroidVersionCode)</ApplicationVersion>
    <ApplicationVersion Condition="'$(ArcForgesAndroidVersionCode)' == ''">1</ApplicationVersion>

    <!-- Android minimum API 26 is carried from the Kotlin baseline; the D-016 minimum-API review stays open.
         Compile/target API 36.1 is the coordinator's D-016 decision (2026-10-08, migration brief section 10): the
         highest platform the pinned maui-android 10.0.20 workload accepts (37.0 is rejected by NETSDK1140). -->
    <!-- The root namespace is ArcForges.Mobile; eng/maui_identity.py refuses any other source namespace. -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion>36.1</TargetPlatformVersion>
    <AndroidSdkBuildToolsVersion>36.1.0</AndroidSdkBuildToolsVersion>

    <!-- P2-021 item 3: Mono runtime, set explicitly. -->
    <UseMonoRuntime>true</UseMonoRuntime>

    <!-- The SDK adds INTERNET to a debuggable manifest only when the profiler is enabled. The profiler stays off so
         that the permission set is exactly the reviewed one, identical in Debug and Release. -->
    <AndroidEnableProfiler>false</AndroidEnableProfiler>
  </PropertyGroup>

  <!-- P2-021 item 3: Mono AOT and .NET trimming plus R8 for the shrunk release build only; Debug uses fast deployment (XA0119). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="ArcForges.Contracts.PublicApi" />
    <!-- AND.40 unit 1: admitted and locked here so the lock covers their closure; the Hello transport (unit 2) uses them. -->
    <PackageReference Include="ArcForges.Contracts.Events" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.Client.Web" />
    <!-- Central version (Directory.Packages.props) pins the trimmer across SDK patch versions. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Hello transport and streaming consumer (AND.40 unit 2). The only project the app references. -->
    <ProjectReference Include="..\core\ArcForges.Mobile.Network\ArcForges.Mobile.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#193E2C" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F5F6EF" BaseSize="128,128" />
  </ItemGroup>

  <!-- Release companion (AND.40 decision 7): the Build information view reads build-identity.json from the path the
       release pipeline writes it to. A build without that file embeds nothing and the view says so at runtime. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\build\generated\licence-assets\build-identity.json')">
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\..\build\generated\licence-assets\build-identity.json" LogicalName="build-identity.json" />
  </ItemGroup>
</Project>
