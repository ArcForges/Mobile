<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Same restrictions as the Kotlin baseline: no backup, no cleartext, INTERNET only. -->
  <application android:allowBackup="false" android:fullBackupContent="false" android:usesCleartextTraffic="false" android:supportsRtl="true"></application>
  <uses-permission android:name="android.permission.INTERNET" />
</manifest>
