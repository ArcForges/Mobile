<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- AND.40 unit 3: the Hello transport needs the network. It is the only permission. Backup, device transfer and
       cleartext stay restricted as in the Kotlin manifest. Activities are declared in code (MainActivity), so the
       manifest declares no component. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="false" android:usesCleartextTraffic="false" android:supportsRtl="true"></application>
</manifest>
